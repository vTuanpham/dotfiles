{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/wake"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "agent-baton guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*([Bb]rowser|[Cc]hrome|[Cc]omputer|[Pp]laywright|[Pp]uppeteer|cua|[Dd]evtools)",
        "hooks": [
          {
            "type": "command",
            "command": "agent-baton guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/tuanpham/.claude/statusline-starship.sh",
    "refreshInterval": 1
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "python3 -I /home/tuanpham/.claude/subagent_statusline.py"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Network posture**: None configured",
      "### User-specific",
      "**Primary use of Claude Code**: software development"
    ]
  }
}
