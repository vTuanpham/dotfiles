#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Adapt the installed Windows ChatGPT browser runtime to WSL stdio."""

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path, PureWindowsPath
import shutil
import subprocess
import sys
import tempfile
import tomllib


HOST = "com.openai.codexextension"
RUNTIME_ENV = (
    "NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS",
    "NODE_REPL_NODE_MODULE_DIRS",
    "NODE_REPL_NODE_PATH",
    "NODE_REPL_TRUSTED_CODE_PATHS",
    "CODEX_HOME",
    "CODEX_CLI_PATH",
    "BROWSER_USE_TINYSKY_ENABLED",
    "BROWSER_USE_CODEX_APP_BUILD_FLAVOR",
    "BROWSER_USE_CODEX_APP_VERSION",
)


def text(value, label):
    if not isinstance(value, str) or not value.strip() or "\0" in value:
        raise ValueError(f"Missing or invalid {label}")
    return value


def wsl_path(value):
    text(value, "path")
    if value.startswith("/"):
        return Path(value)
    if not PureWindowsPath(value).is_absolute():
        raise ValueError("Expected an absolute Windows path")
    return Path(subprocess.check_output(
        ["wslpath", "-u", value], stdin=subprocess.DEVNULL, encoding="utf-8",
    ).strip())


def native_host_path(manifest):
    """Validate the app-owned registration before following its file references."""
    if not isinstance(manifest, dict) or manifest.get("name") != HOST or manifest.get("type") != "stdio":
        raise ValueError("Unexpected native host manifest")
    origins = manifest.get("allowed_origins")
    if not isinstance(origins, list) or not origins or any(
        not isinstance(origin, str)
        or not origin.startswith("chrome-extension://")
        or not origin.endswith("/")
        or "*" in origin
        for origin in origins
    ):
        raise ValueError("Invalid native host allowed_origins")
    return wsl_path(text(manifest.get("path"), "native host path"))


def load_setup(home, manifest, *, host_config=None):
    """Read app-owned state; never copy credentials or computer-control services."""
    host = native_host_path(manifest)
    if host_config is None:
        host_config = json.loads((host.parent / "extension-host-config.json").read_text())
    if not isinstance(host_config, dict):
        raise ValueError("Invalid native host configuration")
    if type(host_config.get("schemaVersion")) is not int or host_config["schemaVersion"] != 1:
        raise ValueError("Unsupported native host configuration schema")
    client = PureWindowsPath(text(host_config.get("browserClientPath"), "browserClientPath"))
    client_path = wsl_path(str(client))
    service = client.with_name("browser-service.mjs")
    skill = client_path.parent.parent / "skills/control-chrome/SKILL.md"
    config = tomllib.loads((home / ".codex/config.toml").read_text())["mcp_servers"]["node_repl"]
    if config.get("args") != []:
        raise ValueError("Unexpected node_repl arguments; review the app runtime before forwarding")
    env = {key: text(config["env"].get(key), key) for key in RUNTIME_ENV}
    command = wsl_path(text(config.get("command"), "node_repl command"))
    for key, field in (("NODE_REPL_NODE_PATH", "nodePath"), ("CODEX_CLI_PATH", "codexCliPath")):
        if wsl_path(env[key]) != wsl_path(text(host_config.get(field), field)):
            raise ValueError(f"App and native host runtimes differ ({field}); run chatgpt-browser repair-runtime for retired paths, or repeat browser setup in the app")
    if command != wsl_path(text(host_config.get("nodeReplPath"), "nodeReplPath")):
        raise ValueError("App and native host runtimes differ (nodeReplPath); run chatgpt-browser repair-runtime for retired paths, or repeat browser setup in the app")
    for path in (host, command, client_path, wsl_path(str(service)), skill,
                 wsl_path(env["NODE_REPL_NODE_PATH"]), wsl_path(env["CODEX_CLI_PATH"])):
        if not path.is_file():
            raise ValueError(f"Required browser runtime file is missing: {path}")
    env["BROWSER_USE_AVAILABLE_BACKENDS"] = "chrome"
    env["NODE_REPL_TRUSTED_SERVICES"] = json.dumps({"browser": str(service)})
    env["WSLENV"] = ":".join(f"{key}/w" for key in env)
    return host, command, env, {"skill": str(skill), "client_url": client.as_uri()}


def read_registration():
    # The app owns the versioned paths; the registry owns native-host discovery.
    command = (
        "$ErrorActionPreference='Stop'; "
        "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); "
        "@{home=[Environment]::GetFolderPath('UserProfile'); "
        "manifest=(Get-Item 'HKCU:/Software/Google/Chrome/NativeMessagingHosts/"
        + HOST + "').GetValue('')} | ConvertTo-Json -Compress"
    )
    result = json.loads(subprocess.check_output(
        ["powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", command],
        # A Windows discovery process must not drain the caller's framed stdio.
        stdin=subprocess.DEVNULL, encoding="utf-8", timeout=20,
    ))
    home = wsl_path(text(result.get("home"), "Windows home"))
    manifest = json.loads(wsl_path(text(result.get("manifest"), "native host registration")).read_text())
    return home, manifest


def discover():
    home, manifest = read_registration()
    return home, manifest, load_setup(home, manifest)


def register_linux(root, manifest):
    if not root.is_dir():
        raise ValueError("Pass an existing Chrome user-data directory, not a profile subdirectory")
    destination = root / "NativeMessagingHosts" / f"{HOST}.json"
    wanted = {**manifest, "path": str(Path(__file__).absolute())}
    if destination.exists():
        if json.loads(destination.read_text()) != wanted:
            raise ValueError(f"Existing native host differs; left unchanged: {destination}")
        return
    destination.parent.mkdir(parents=True, exist_ok=True)
    with destination.open("x") as output:
        output.write(json.dumps(wanted, indent=2) + "\n")


def repair_runtime(home, manifest):
    """Refresh retired executable paths, preserving registration and access settings."""
    host = native_host_path(manifest)
    destination = host.parent / "extension-host-config.json"
    original = destination.read_bytes()
    current = json.loads(original)
    config_path = home / ".codex/config.toml"
    config_bytes = config_path.read_bytes()
    configured = tomllib.loads(config_bytes.decode())["mcp_servers"]["node_repl"]
    wanted = dict(current)
    values = {
        "nodePath": configured["env"]["NODE_REPL_NODE_PATH"],
        "codexCliPath": configured["env"]["CODEX_CLI_PATH"],
        "nodeReplPath": configured["command"],
    }
    changed = []
    for field, value in values.items():
        path = wsl_path(text(value, field))
        if path == wsl_path(text(current.get(field), field)):
            continue
        wanted[field] = str(PureWindowsPath(value)) if PureWindowsPath(value).is_absolute() else subprocess.check_output(
            ["wslpath", "-w", str(path)], stdin=subprocess.DEVNULL, encoding="utf-8",
        ).strip()
        changed.append(field)
    load_setup(home, manifest, host_config=wanted)
    if not changed:
        print("Browser runtime paths already match; no changes made")
        return
    if all(wsl_path(current[field]).is_file() for field in changed):
        raise ValueError("Both registered and configured runtimes still exist; select the intended setup in the app")
    state = Path(os.environ.get("XDG_STATE_HOME", ""))
    if not state.is_absolute():
        state = Path.home() / ".local/state"
    backup = state / "backups/chrome" / datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    backup.mkdir(mode=0o700, parents=True)
    for name, payload in (
        ("extension-host-config.json", original),
        ("origin.json", json.dumps({
            "original_path": str(destination), "sha256": hashlib.sha256(original).hexdigest(),
            "restore": "Restore extension-host-config.json to original_path after confirming the registered runtime is installed.",
        }, indent=2).encode()),
    ):
        with os.fdopen(os.open(backup / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as output:
            output.write(payload)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write((json.dumps(wanted, indent=2) + "\n").encode())
            output.flush()
            os.fsync(output.fileno())
        if destination.read_bytes() != original or config_path.read_bytes() != config_bytes:
            raise ValueError("Browser setup changed during repair; retry diagnostics")
        os.replace(temporary, destination)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    load_setup(home, manifest)
    print(f"Updated retired runtime paths: {', '.join(changed)}; backup: {backup}")


def doctor(user_data_dir=None):
    """Read-only installation checks; browser consent/connection stays in the native harness."""
    failed = False

    def report(label, problem=None):
        nonlocal failed
        failed |= problem is not None
        print(f"{'FIX' if problem else 'ok '}  {label}" + (f": {problem}" if problem else ""))

    for executable in ("powershell.exe", "wslpath"):
        report(executable, None if shutil.which(executable) else "not on PATH")
    try:
        _, manifest, _ = discover()
        report("Windows native host and installed browser runtime")
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        report("Windows native host and installed browser runtime", str(error))
        manifest = None

    try:
        config = tomllib.loads((Path.home() / ".codex/config.toml").read_text())
        entry = config["mcp_servers"]["node_repl"]
        command = text(entry.get("command"), "MCP command")
        args = entry.get("args", [])
        adapter = Path(__file__).resolve()
        executable = shutil.which(command) or command
        uses_adapter = Path(executable).expanduser().resolve() == adapter or any(
            isinstance(arg, str) and Path(arg).expanduser().resolve() == adapter for arg in args
        )
        if entry.get("enabled") is False or "mcp" not in args or not uses_adapter:
            raise ValueError("register node_repl with this adapter's mcp command; see chrome/README.md")
        if not Path(executable).is_file() or not os.access(executable, os.X_OK):
            raise ValueError("the registered MCP executable is missing or not executable")
        report("Codex MCP launcher")
    except (OSError, ValueError, KeyError, TypeError) as error:
        report("Codex MCP launcher", str(error))

    roots = [user_data_dir.expanduser()] if user_data_dir else [
        Path.home() / ".config" / name
        for name in ("google-chrome", "google-chrome-beta", "google-chrome-unstable", "chromium")
        if (Path.home() / ".config" / name).is_dir()
    ]
    for root in roots:
        registration = root / "NativeMessagingHosts" / f"{HOST}.json"
        if not registration.exists() and user_data_dir is None:
            print(f"not configured: Linux native host ({root.name}); use doctor <user-data-dir> to require it")
            continue
        try:
            local = json.loads(registration.read_text())
            if manifest is None:
                raise ValueError("Windows registration must pass before validating this adapter")
            if local != {**manifest, "path": str(Path(__file__).absolute())}:
                raise ValueError("registration differs; review register-linux setup")
            report(f"Linux native host ({root.name})")
        except (OSError, ValueError) as error:
            report(f"Linux native host ({root.name})", str(error))
    print("not probed: active extension connection; verify with the native Chrome tools in your harness")
    return int(failed)


def main():
    if len(sys.argv) == 2 and sys.argv[1].startswith("chrome-extension://"):
        home, manifest, (host, _, _, _) = discover()
        if sys.argv[1] not in manifest["allowed_origins"]:
            raise ValueError("Extension origin is not allowed by the installed native host")
        os.chdir(host.parent)
        os.execv(str(host), [str(host), sys.argv[1]])
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("mcp", "paths", "register-linux", "doctor", "repair-runtime"))
    parser.add_argument("user_data_dir", nargs="?", type=Path)
    parser.add_argument("--disable-sandbox", action="store_true",
                        help="Explicit exception for the Windows browser kernel only; keeps MCP approval review")
    args = parser.parse_args()
    if args.disable_sandbox and args.mode != "mcp":
        parser.error("--disable-sandbox is only valid with mcp")
    if args.mode == "doctor":
        return doctor(args.user_data_dir)
    if (args.mode == "register-linux") != (args.user_data_dir is not None):
        parser.error("register-linux requires a Chrome user-data directory; other modes take none")
    if args.mode == "repair-runtime":
        home, manifest = read_registration()
        repair_runtime(home, manifest)
        return
    home, manifest, (_, command, env, paths) = discover()
    if args.mode == "paths":
        print(json.dumps(paths))
    elif args.mode == "register-linux":
        register_linux(args.user_data_dir.expanduser().absolute(), manifest)
    else:
        os.chdir(home)
        # Keep inherited protocol/auth context; forward only the app's browser runtime settings.
        command_args = [str(command)]
        if args.disable_sandbox:
            command_args.append("--disable-sandbox")
        os.execve(str(command), command_args, {**os.environ, **env})


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f"chatgpt-browser: {error}. Check Settings > Computer Use in the Windows app.", file=sys.stderr)
        sys.exit(1)
