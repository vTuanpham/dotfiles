{
  "agent-process-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/libexec/agent-process-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
