[Unit]
Description=Private phone inbox for root agent conversations
After=network.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/agent-inbox/environment
ExecStart=%h/.local/bin/agent-inbox --state %h/.local/state/agent-inbox serve --public-url=${AGENT_INBOX_PUBLIC_URL}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=agent-inbox
StateDirectoryMode=0700
ReadWritePaths=%h/.local/state/agent-inbox

[Install]
WantedBy=default.target
